# ==========================================
# TripPilot-AI - Git Ignore
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
dist-ssr/
build/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local and temporary files
*.local
*.tmp
*.temp
*.swp
*.swo

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Testing and caches
.nyc_output/
.cache/
.eslintcache
.parcel-cache/
.vite/

# Deployment metadata
.vercel/
.render/